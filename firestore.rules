rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // เปลี่ยน EMAIL ให้ตรงกับบัญชีที่สร้างใน Authentication
      allow read, write: if request.auth != null
        && request.auth.token.email == commerv1@gmail.com';
    }
  }
}
